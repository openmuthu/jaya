<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.jaya.android.TableOfContentsActivity"
    android:fitsSystemWindows="true">

    <!-- Search bar pinned at the top -->
    <LinearLayout
        android:id="@+id/toc_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:scaleType="fitCenter"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="6dp"/>

        <EditText
            android:id="@+id/toc_search_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/toc_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:maxLines="1"
            android:background="@null"
            android:textSize="16sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"/>

        <ImageButton
            android:id="@+id/toc_search_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:visibility="gone"
            android:contentDescription="Clear search"/>

    </LinearLayout>

    <!-- Thin divider below search bar -->
    <View
        android:id="@+id/toc_search_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/toc_search_bar"
        android:background="?android:attr/dividerHorizontal"/>

    <!-- Main TOC tree (always present, below search bar) -->
    <org.jaya.android.JayaDocListView
        android:id="@+id/toc_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toc_search_divider"/>

    <!-- Search results overlay (shown on top of tree when query is non-empty) -->
    <ListView
        android:id="@+id/toc_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toc_search_divider"
        android:background="?android:attr/windowBackground"
        android:visibility="gone"
        android:divider="?android:attr/listDivider"
        android:dividerHeight="1dp"/>

</RelativeLayout>
